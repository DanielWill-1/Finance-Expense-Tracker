NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=./data/ghostledger.db
ALLOW_REMOTE=false
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001

# Optional AI fallback credentials. You can also paste a key in Settings; a key saved there takes
# priority over its matching environment value. Environment values are never stored in SQLite or
# returned by the API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional override for local backend use. Compose defaults to host.docker.internal.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
